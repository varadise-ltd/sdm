OIDC_END_SESSION_ENDPOINT=
SDM_OIDC_REDIRECT_URI=http://localhost:3001/api/auth/oidc/callback
SDM_OIDC_POST_LOGOUT_REDIRECT_URI=http://localhost:3001/login
S3_ENDPOINT=http://localhost:9000
